# development | production
ENVIRONMENT=development
# Runtime DB. For Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Optional: DB URL for Alembic. For Supabase use the session pooler (port 5432).
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# >= 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
# JSON list of browser origins allowed to call the API (CORS + Origin check)
FRONTEND_ORIGINS=["http://localhost:3000"]
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Local directory for processed image files
MEDIA_ROOT=media
MAX_UPLOAD_BYTES=10485760
# Sign-ups allowed per client IP per hour
REGISTER_LIMIT_PER_HOUR=5
